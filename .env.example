APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Local:  mongodb://localhost:27017   (leave username/password blank)
# Atlas:  mongodb+srv://cluster0.xxxxx.mongodb.net   + username/password below
MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=enterprise_rag

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object storage (MinIO in dev). docker compose overrides the endpoint to http://minio:9000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ekip-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
MAX_UPLOAD_MB=25
