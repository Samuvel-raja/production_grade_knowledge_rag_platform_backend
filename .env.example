APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Local:  mongodb://localhost:27017   (leave username/password blank)
# Atlas:  mongodb+srv://cluster0.xxxxx.mongodb.net   + username/password below
MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=enterprise_rag

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploaded file bytes are held in memory for one request and discarded — no
# object storage for now (deferred, see plan/backend/phase-2b-storage-and-workers.md).
MAX_UPLOAD_MB=25

# Vector search + embeddings (Phase 3). Leave blank to run Phases 1-2 only —
# documents will process but stay unindexed (chunk_count 0).
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

CHUNK_STRATEGY=structural
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MAX_CHUNK_METADATA_CHARS=4000

# LLM (Phase 4) — server-wide default, used when a user hasn't set their own
# key in Settings. provider is one of: openai, gemini, openrouter, groq.
# Leave blank to run Phases 1-3 only — /search returns 503 until either this
# or a per-user key (Settings > LLM) is set.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_TOP_K=5

# Encrypts per-user LLM API keys at rest (Fernet, urlsafe-base64, 32 bytes).
# Required before a user can save their own key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
